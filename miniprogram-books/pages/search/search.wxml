<view class="page">
  <view class="search-bar">
    <view class="search-input-box">
      <input
        class="search-input"
        placeholder-class="search-placeholder"
        placeholder="书名、作者、简介"
        value="{{keyword}}"
        focus
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onSubmit"
      />
      <text wx:if="{{keyword}}" class="clear-btn" bindtap="onClear">×</text>
    </view>
    <text class="cancel-btn" bindtap="onCancel">取消</text>
  </view>

  <view class="filter-card">
    <view class="filter-row">
      <text class="filter-label">分类</text>
      <picker class="filter-picker" mode="selector" range="{{categoryOptions}}" bindchange="onCategoryChange">
        <view class="picker-value">{{selectedCategory || '全部分类'}}</view>
      </picker>
    </view>
    <view class="filter-row">
      <text class="filter-label">标签</text>
      <picker class="filter-picker" mode="selector" range="{{tagOptions}}" bindchange="onTagChange">
        <view class="picker-value">{{selectedTag || '全部标签'}}</view>
      </picker>
    </view>
  </view>

  <!-- 历史搜索 -->
  <view wx:if="{{!searched && histories.length}}" class="history-box">
    <view class="history-header">
      <text class="history-title">历史搜索</text>
      <text class="history-clear" bindtap="onClearHistory">清空</text>
    </view>
    <view class="history-list">
      <text
        wx:for="{{histories}}"
        wx:key="*this"
        class="history-item"
        data-kw="{{item}}"
        bindtap="onHistoryTap"
      >{{item}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-box">
    <text class="state-text">搜索中…</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="state-box">
    <text class="state-text">书籍数据加载失败</text>
    <text wx:if="{{loadError}}" class="error-detail">原因：{{loadError}}</text>
  </view>

  <view wx:elif="{{searched && list.length === 0}}" class="state-box">
    <text class="state-icon">📚</text>
    <text class="state-text">{{keyword ? '没有找到「' + keyword + '」相关的书籍' : '没有符合条件的书籍'}}</text>
    <text class="state-tip">换个关键词或调整分类/标签试试</text>
  </view>

  <block wx:elif="{{list.length > 0}}">
    <view class="result-tip">找到 {{total}} 本书<block wx:if="{{total > list.length}}">，显示前 {{list.length}} 本</block></view>
    <view class="book-list">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="book-card"
        data-id="{{item.id}}"
        bindtap="onBookTap"
      >
        <image class="cover-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <text class="card-author">{{item.author}}</text>
          <text class="card-excerpt">{{item.excerpt}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
