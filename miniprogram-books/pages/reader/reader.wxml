<view class="reader-page theme-{{theme}}">
  <view wx:if="{{loading}}" class="state-box">
    <text class="state-text">正在加载书籍…</text>
  </view>

  <view wx:elif="{{error}}" class="state-box">
    <text class="state-text">{{error}}</text>
    <button class="retry-btn" size="mini" bindtap="onRetry">重试</button>
  </view>

  <block wx:else>
    <!-- 顶部工具栏：菜单打开时显示 -->
    <view wx:if="{{showMenu}}" class="reader-toolbar">
      <view class="toolbar-info">
        <text class="toolbar-title">{{chapterTitle}}</text>
      </view>
      <text
        class="toolbar-shelf {{inShelf ? 'in-shelf' : ''}}"
        catchtap="onToggleShelf"
      >{{inShelf ? '已收藏' : '加入收藏'}}</text>
    </view>

    <!-- 正文区：按屏分页展示，点击左/右 1/3 翻页（中间 1/3 唤出菜单） -->
    <scroll-view
      class="reader-body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-top="{{scrollTop}}"
      scroll-with-animation="{{false}}"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <text
        class="reader-content"
        style="font-size: {{fontSize}}rpx; line-height: {{lineHeight}}; font-family: {{fontFamily}};"
      >{{pageContent}}</text>

      <!-- 信息流（原生模板）广告：内嵌在正文下方，不单独成页 -->
      <view
        wx:if="{{feedAdVisible}}"
        class="reader-inline-ad"
        catchtouchstart="noop"
        catchtouchend="noop"
      >
        <text class="ad-badge">广告</text>
        <ad-custom
          unit-id="{{adUnitId}}"
          bindload="onFeedAdLoad"
          binderror="onFeedAdError"
        ></ad-custom>
      </view>
    </scroll-view>

    <!-- 底部常驻 banner 广告（占位，不被底部菜单遮挡）；无填充时自动隐藏 -->
    <view wx:if="{{bannerVisible}}" class="reader-banner">
      <ad
        unit-id="{{bannerUnitId}}"
        bindload="onBannerLoad"
        binderror="onBannerError"
      ></ad>
    </view>

    <!-- 底部菜单：菜单打开时浮在正文之上（不占位，避免底部留白）；有 banner 时上移，避免遮挡 -->
    <view
      wx:if="{{showMenu}}"
      class="reader-footer"
      style="bottom: {{bannerHeight ? bannerHeight + 'px' : '0px'}}"
    >
      <!-- 激励视频未看完 → 后续章节锁定提示 -->
      <view wx:if="{{chapterLocked}}" class="lock-tip" bindtap="onUnlockTip">
        <text>后续章节已锁定，点此看完广告即可解锁</text>
      </view>

      <view class="foot-nav">
        <view
          class="nav-btn {{chapterIndex <= 0 ? 'disabled' : ''}}"
          bindtap="onPrevChapter"
        >‹ 上一章</view>
        <slider
          class="chapter-slider"
          min="0"
          max="{{chapterCount - 1}}"
          step="1"
          value="{{chapterIndex}}"
          activeColor="#a08a68"
          backgroundColor="#d8c9ad"
          block-size="18"
          bindchanging="onChapterSliderChanging"
          bindchange="onChapterSliderChange"
        />
        <view
          class="nav-btn {{chapterIndex >= chapterCount - 1 ? 'disabled' : ''}}"
          bindtap="onNextChapter"
        >下一章 ›</view>
      </view>

      <view class="foot-icons">
        <view class="icon-item" bindtap="onPickChapter">
          <text class="icon-glyph">☰</text>
          <text class="icon-label">目录</text>
        </view>
        <view class="icon-item" bindtap="onToggleNight">
          <text class="icon-glyph">{{theme === 'night' ? '☀' : '🌙'}}</text>
          <text class="icon-label">{{theme === 'night' ? '日间' : '夜间'}}</text>
        </view>
        <view class="icon-item" bindtap="onOpenSettings">
          <text class="icon-glyph">⚙</text>
          <text class="icon-label">设置</text>
        </view>
        <view class="icon-item" bindtap="onFreeAd">
          <text class="icon-glyph">🎁</text>
          <text class="icon-label">{{adFree ? '免广告中' : '免广告'}}</text>
        </view>
      </view>
    </view>

    <!-- 阅读设置弹窗 -->
    <view wx:if="{{showSettings}}" class="modal-mask" bindtap="onCloseSettings">
      <view class="settings-modal" catchtap="noop">
        <view class="modal-header">
          <text class="modal-title">阅读设置</text>
          <text class="modal-close" bindtap="onCloseSettings">×</text>
        </view>

        <view class="settings-content">
          <view class="setting-section">
            <text class="setting-label">字体大小</text>
            <view class="setting-control">
              <button class="control-btn" size="mini" bindtap="onFontSmaller">A-</button>
              <slider class="size-slider" value="{{fontSize}}" min="24" max="48" bindchange="onFontSizeChange" activeColor="#4a3728" block-size="18" />
              <button class="control-btn" size="mini" bindtap="onFontLarger">A+</button>
            </view>
          </view>

          <view class="setting-section">
            <text class="setting-label">字体</text>
            <view class="option-group">
              <view
                wx:for="{{fontFamilies}}"
                wx:key="value"
                class="option-item {{fontFamily === item.value ? 'active' : ''}}"
                bindtap="onFontFamilyChange"
                data-value="{{item.value}}"
              >
                <text style="font-family: {{item.value}};">{{item.name}}</text>
              </view>
            </view>
          </view>

          <view class="setting-section">
            <text class="setting-label">行距</text>
            <view class="option-group">
              <view
                wx:for="{{lineSpacings}}"
                wx:key="*this"
                class="option-item {{lineHeight == item ? 'active' : ''}}"
                bindtap="onLineSpacingChange"
                data-value="{{item}}"
              >
                <text>{{item}}</text>
              </view>
            </view>
          </view>

          <view class="setting-section">
            <text class="setting-label">背景</text>
            <view class="option-group">
              <view
                wx:for="{{themes}}"
                wx:key="value"
                class="option-item {{theme === item.value ? 'active' : ''}}"
                bindtap="onThemeChange"
                data-value="{{item.value}}"
              >
                <text>{{item.name}}</text>
              </view>
            </view>
          </view>

        </view>
      </view>
    </view>

    <!-- 章节目录弹窗 -->
    <view wx:if="{{showToc}}" class="modal-mask" bindtap="onCloseToc">
      <view class="toc-modal" catchtap="noop">
        <view class="modal-header">
          <text class="modal-title">目录（共 {{chapterCount}} 章）</text>
          <text class="modal-close" bindtap="onCloseToc">×</text>
        </view>

        <scroll-view class="toc-list" scroll-y enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{tocList}}"
            wx:key="index"
            class="toc-item {{index === chapterIndex ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onTocItemTap"
          >
            <text>{{item}}</text>
          </view>
          <view wx:if="{{tocHasMore}}" class="toc-more" bindtap="onLoadMoreToc">
            <text>加载更多…</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </block>

  <!-- 隐藏测量区：批量量出每页真实渲染高度（宽高与正文区一致，不参与可见布局） -->
  <view class="measure-box">
    <text
      wx:for="{{measureTexts}}"
      wx:key="index"
      class="measure-text"
      style="font-size: {{fontSize}}rpx; line-height: {{lineHeight}}; font-family: {{fontFamily}};"
    >{{item}}</text>
  </view>
</view>
