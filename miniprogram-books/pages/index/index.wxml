<view class="page">
  <view class="masthead">
    <text class="masthead-title">数维探索</text>
    <text class="masthead-sub">精选小说书单</text>
  </view>

  <!-- 首页只保留关键词入口，分类/标签筛选已移至搜索页 -->
  <view class="filter-card">
    <view class="filter-row search-row">
      <text class="filter-label">关键词</text>
      <view class="search-box search-entry" bindtap="onOpenSearch">
        <text class="search-entry-text {{keyword ? '' : 'is-placeholder'}}">{{keyword || '请输入书名、作者、简介'}}</text>
        <text class="search-entry-icon">🔍</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="no-results">
    <text class="no-results-icon">📖</text>
    <text>书卷加载中…</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="no-results">
    <text class="no-results-icon">📡</text>
    <text>书卷加载失败</text>
    <text class="no-results-tip">请检查网络后重试</text>
    <text wx:if="{{loadError}}" class="error-detail">原因：{{loadError}}</text>
    <button class="retry-btn" size="mini" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{list.length > 0}}" class="book-grid">
    <block
      wx:for="{{list}}"
      wx:key="id"
    >
      <view
        class="book-card"
        data-id="{{item.id}}"
        bindtap="onBookTap"
      >
        <view class="card-cover">
          <image class="cover-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <text class="category-badge">{{item.category}}</text>
          <text
            wx:if="{{item.latestChapter}}"
            class="chapter-badge"
          >最新章节</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <text class="card-author">{{item.author}}</text>
          <text class="card-excerpt">{{item.excerpt}}</text>
          <view class="card-tags">
            <text
              wx:for="{{item.tags}}"
              wx:for-item="tag"
              wx:key="name"
              class="tag tag-{{tag.type}}"
            >{{tag.name}}</text>
          </view>
          <text class="read-btn">查看详情</text>
        </view>
      </view>

      <!-- 第 4 本书之后插入原生模板广告（位于列表中部） -->
      <view wx:if="{{index === 3}}" class="ad-slot">
        <ad-custom
          unit-id="adunit-c3cb35ea07fdb0be"
          bindload="adLoad"
          binderror="adError"
          bindclose="adClose"
        ></ad-custom>
      </view>
    </block>

    <!-- 列表末尾同样插入原生模板广告 -->
    <view class="ad-slot ad-slot-end">
      <ad-custom
        unit-id="adunit-df43d35ba4890867"
        bindload="adLoad"
        binderror="adError"
        bindclose="adClose"
      ></ad-custom>
    </view>
  </view>

  <view wx:else class="no-results">
    <text class="no-results-icon">📚</text>
    <text>暂无匹配的书籍</text>
    <text class="no-results-tip">请关注微信公众号「数维探索」留言你想找的书籍</text>
  </view>
</view>
