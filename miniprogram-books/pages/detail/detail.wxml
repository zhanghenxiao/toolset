<view wx:if="{{book}}" class="detail-page">
  <view class="hero">
    <image class="hero-cover" src="{{book.cover}}" mode="aspectFill" />
    <view class="hero-info">
      <text class="hero-title">{{book.title}}</text>
      <text class="hero-author">{{book.author}}</text>
      <view wx:if="{{book.category}}" class="hero-meta">
        <text class="meta-item">{{book.category}}</text>
      </view>
      <view wx:if="{{book.tags && book.tags.length}}" class="hero-tags">
        <text
          wx:for="{{book.tags}}"
          wx:key="name"
          class="tag tag-{{item.type || 'other'}}"
        >{{item.name}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{book.excerpt}}" class="section">
    <text class="section-title">内容简介</text>
    <text class="section-content">{{book.excerpt}}</text>
  </view>

  <view
    wx:if="{{book.latestChapter}}"
    class="section section-latest"
    bindtap="onLatestChapterTap"
  >
    <text class="section-title">最新章节</text>
    <text class="section-content latest">{{book.latestChapter}}</text>
    <!-- <text class="latest-hint">点击查看激励视频广告后获取网盘分享链接</text> -->
  </view>

  <!-- <view class="actions">
    <button class="action-btn primary" bindtap="onStartRead">开始阅读</button>
    <button class="action-btn secondary" bindtap="onOpenReadUrl">在浏览器打开</button>
  </view> -->

  <!-- <view class="tip">阅读链接为夸克网盘分享，复制后在浏览器打开即可</view> -->
</view>